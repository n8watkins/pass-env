# pass-env reference file: variable name = entry name in pass. Names only, never values.
# Safe to commit. Check with: pass-env check   Run with: pass-env run -- pnpm dev
# Moving from a .env file? pass-env import .env.local --prefix myapp --dry-run

# Keys a provider gave you (store with: pass-env set <entry>)
STRIPE_SECRET_KEY=myapp/STRIPE_SECRET_KEY
OPENAI_API_KEY=myapp/OPENAI_API_KEY

# One key shared by several projects
GEMINI_API_KEY=shared/GEMINI_API_KEY

# Secrets you invent (store with: pass-env generate <entry>)
AUTH_SECRET=myapp/AUTH_SECRET
CRON_SECRET=myapp/CRON_SECRET

# Multi-line values such as PEM keys or JSON
FIREBASE_ADMIN_PRIVATE_KEY=multiline:myapp/FIREBASE_ADMIN_PRIVATE_KEY
